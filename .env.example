# Database
# Use Neon's pooled connection for application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full"
# Use Neon's direct connection for Prisma migrations and administrative commands.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full"

# Better Auth (Phase 2 foundation)
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare account and private R2 bucket
CLOUDFLARE_ACCOUNT_ID="replace-with-cloudflare-account-id"
R2_BUCKET_NAME="vidportal-development"
R2_ACCESS_KEY_ID="replace-with-bucket-scoped-access-key"
R2_SECRET_ACCESS_KEY="replace-with-bucket-scoped-secret-key"

# Cloudflare Stream
CLOUDFLARE_STREAM_API_TOKEN="replace-with-least-privilege-stream-token"
CLOUDFLARE_STREAM_CUSTOMER_CODE="replace-with-stream-customer-code"
CLOUDFLARE_STREAM_WEBHOOK_SECRET="replace-with-stream-webhook-signing-secret"

# Transactional email
RESEND_API_KEY="re_replace_with_resend_api_key"
RESEND_FROM_EMAIL="VidPortal <noreply@example.com>"
# RESEND_REPLY_TO_EMAIL="support@example.com"

# Tests
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=verify-full"
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"

# Optional operational tuning
# LOG_LEVEL="info"
# R2_PRESIGNED_URL_TTL_SECONDS="900"
# STREAM_TOKEN_TTL_SECONDS="900"
